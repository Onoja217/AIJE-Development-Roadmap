
# Community integration mode: demo | staging | live
# Deployment target: preview | staging | production. Production builds fail
# unless this is explicit; production also requires live integration mode.
VITE_DEPLOYMENT_ENV=preview

# Required Supabase browser credentials (the publishable/anon key is safe for
# client use; never place the service-role key in a VITE_ variable).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# demo   -> local demo datasets, no network calls
# staging/live -> real endpoints below are used
VITE_COMMUNITY_SYNC_MODE=demo

# Integration feature switches (ignored in demo mode)
VITE_SAFEBENUE_ENABLED=false
VITE_OSIRIS_ENABLED=false

# SafeBenue is reached only through the authenticated Supabase Edge Function.
# These values are Edge Function secrets, never browser variables.
SAFEBENUE_UPSTREAM_BASE_URL=https://api.safebenue.example/v1
SAFEBENUE_UPSTREAM_TOKEN=
SAFEBENUE_ADAPTER_ALLOWED_ORIGINS=https://guardian-pulse-one.vercel.app

# Osiris is reached only through the authenticated Supabase Edge Function.
# The browser never receives an upstream URL or shared integration token.
OSIRIS_ADAPTER_ALLOWED_ORIGINS=https://guardian-pulse-one.vercel.app
OSIRIS_UPSTREAM_BASE_URL=https://osirisai.live/api
OSIRIS_UPSTREAM_TOKEN=

# Minimum supported interval is 5000 milliseconds
VITE_COMMUNITY_SYNC_INTERVAL_MS=30000
